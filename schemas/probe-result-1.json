{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/InstallZero/installzero/main/schemas/probe-result-1.json",
  "title": "InstallZero probe result, version 1",
  "description": "What a probe run wrote and how it went (<run-id>.result.json, or the -ResultFile the eval worker passes). Eval scoring and the console read it.",
  "type": "object",
  "required": ["run_id", "target", "no_docs", "out", "model", "prompt_version", "finished", "summary", "gaps", "confidence", "draft_checks", "stats", "transcript"],
  "$comment": "target_env, context, blind, saved, stop_reason and the stats repeats and server_errors are written by every current probe; results from before mid-October 2026 lack them.",
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "pattern": "^\\d{8}-\\d{6}(-\\d+)?$", "description": "Start time and process id (older runs: start time only)." },
    "target": { "type": "string", "description": "The install folder examined; empty when the model had to find it." },
    "target_env": { "type": "string", "pattern": "^(local|wsl:.+)$" },
    "no_docs": { "type": "boolean", "description": "READMEs and docs were hidden from the model." },
    "out": { "type": "string", "description": "The install.md written; empty when none was." },
    "model": { "type": "string" },
    "context": { "type": "integer", "minimum": 0 },
    "prompt_version": { "type": "string", "description": "probe-<n>, from prompts/probe.md; changes whenever the prompt does." },
    "blind": {
      "description": "How the probe was kept from seeing the original install files.",
      "type": "object",
      "required": ["hidden_paths", "hidden_attempts", "withheld_lines", "guarded_lines"],
      "additionalProperties": false,
      "properties": {
        "hidden_paths": { "type": "array", "items": { "type": "string" } },
        "hidden_attempts": { "type": "integer", "minimum": 0 },
        "withheld_lines": { "type": "integer", "minimum": 0 },
        "guarded_lines": { "type": "integer", "minimum": 0 }
      }
    },
    "saved": { "type": "boolean" },
    "finished": { "type": "boolean" },
    "stop_reason": { "enum": ["finished", "timeout", "budget", "model-errors", "no-tool-calls", "unchanged-writes", "error"] },
    "summary": { "type": "string" },
    "gaps": { "type": "string" },
    "confidence": { "type": "string" },
    "draft_checks": {
      "description": "The last saved draft's format problems and its detect/verify blocks run here; null when nothing was saved.",
      "type": ["object", "null"],
      "required": ["steps", "problems", "passed", "failed", "untested"],
      "additionalProperties": false,
      "properties": {
        "steps": { "type": "integer", "minimum": 0 },
        "problems": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "untested": { "type": "integer", "minimum": 0 }
      }
    },
    "stats": {
      "type": "object",
      "required": ["tool_calls", "model_turns", "invalid_calls", "nudges", "seconds", "prompt_tokens", "completion_tokens", "error"],
      "additionalProperties": false,
      "properties": {
        "tool_calls": { "type": "integer", "minimum": 0 },
        "model_turns": { "type": "integer", "minimum": 0 },
        "invalid_calls": { "type": "integer", "minimum": 0 },
        "repeats": { "type": "integer", "minimum": 0 },
        "nudges": { "type": "integer", "minimum": 0 },
        "seconds": { "type": "number", "minimum": 0 },
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "server_errors": { "type": "integer", "minimum": 0 },
        "error": { "type": "string" }
      }
    },
    "transcript": { "type": "string" }
  }
}
